# USF API Configuration
USF_API_KEY=your_usf_api_key_here
USF_API_URL=https://api.us.inc/usf/v1/hiring/chat/completions
USF_EMBED_URL=https://api.us.inc/usf/v1/embed/embeddings

# Qdrant Configuration
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
LLM_MODEL=gpt-5
CHUNKING_LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=3072
LLM_MAX_CONCURRENT=8
LLM_TIMEOUT=600
L2_MAX_OUTPUT_TOKENS=2500

# MongoDB Configuration (optional)
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=mechanical_chatbot
